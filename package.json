{
  "name": "throughline",
  "version": "0.6.1",
  "description": "An open-source desktop workspace for Claude Code and Codex. Keep project context and switch agents without starting over, using your own accounts.",
  "keywords": [
    "claude-code",
    "codex",
    "ai",
    "coding-agent",
    "desktop",
    "electron"
  ],
  "homepage": "https://github.com/AhmedNavaz/throughline#readme",
  "bugs": {
    "url": "https://github.com/AhmedNavaz/throughline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedNavaz/throughline.git"
  },
  "license": "MIT",
  "author": "Ahmed Nawaz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "main": "desktop/main.mjs",
  "productName": "Throughline",
  "scripts": {
    "start": "node desktop/launch.mjs",
    "start:fresh": "node desktop/launch.mjs --fresh",
    "desktop": "node desktop/launch.mjs",
    "web": "node server.mjs",
    "test": "node --test test/*.test.mjs sharing/test/*.test.mjs",
    "test:desktop": "node desktop/launch.mjs --smoke-test",
    "sharing": "node sharing/server.mjs",
    "package": "node desktop/package.mjs",
    "icons": "electron desktop/icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.302"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.0"
  }
}
